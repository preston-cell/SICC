generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AgentRun {
  id           String          @id @default(cuid())
  prompt       String
  status       RunStatus       @default(pending)
  output       String?
  error        String?
  createdAt    DateTime        @default(now())
  completedAt  DateTime?
  estatePlanId String?
  runType      String?
  estatePlan   EstatePlan?     @relation(fields: [estatePlanId], references: [id])
  documents    Document[]
  gapAnalyses  GapAnalysis[]
  files        GeneratedFile[]

  @@index([createdAt])
  @@index([estatePlanId])
}

model GeneratedFile {
  id       String   @id @default(cuid())
  runId    String
  path     String
  content  String
  isBinary Boolean  @default(false)
  size     Int
  run      AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String
  clerkId     String?      @unique
  createdAt   DateTime     @default(now())
  lastLoginAt DateTime?
  estatePlans EstatePlan[]
  reminders   Reminder[]

  @@index([email])
  @@index([clerkId])
}

model EstatePlan {
  id                      String                   @id @default(cuid())
  userId                  String?
  sessionId               String?
  name                    String                   @default("My Estate Plan")
  status                  EstatePlanStatus         @default(draft)
  stateOfResidence        String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  agentRuns               AgentRun[]
  attorneyQuestions       AttorneyQuestion[]
  beneficiaryDesignations BeneficiaryDesignation[]
  documents               Document[]
  documentChecklistItems  DocumentChecklistItem[]
  user                    User?                    @relation(fields: [userId], references: [id])
  extractedIntakeData     ExtractedIntakeData[]
  familyContacts          FamilyContact[]
  gapAnalyses             GapAnalysis[]
  gapAnalysisRuns         GapAnalysisRun[]
  guidedIntakeProgress    GuidedIntakeProgress?
  intakeData              IntakeData[]
  lifeEvents              LifeEvent[]
  reminders               Reminder[]
  uploadedDocuments       UploadedDocument[]

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
}

model IntakeData {
  id           String        @id @default(cuid())
  estatePlanId String
  section      IntakeSection
  data         String
  isComplete   Boolean       @default(false)
  completedAt  DateTime?
  updatedAt    DateTime      @updatedAt
  estatePlan   EstatePlan    @relation(fields: [estatePlanId], references: [id], onDelete: Cascade)

  @@unique([estatePlanId, section])
  @@index([estatePlanId])
}

model Document {
  id           String         @id @default(cuid())
  estatePlanId String
  runId        String?
  type         DocumentType
  title        String
  content      String
  format       DocumentFormat @default(markdown)
  version      Int            @default(1)
  status       DocumentStatus @default(draft)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  estatePlan   EstatePlan     @relation(fields: [estatePlanId], references: [id], onDelete: Cascade)
  run          AgentRun?      @relation(fields: [runId], references: [id])

  @@index([estatePlanId])
  @@index([estatePlanId, type])
}

model GapAnalysis {
  id                 String     @id @default(cuid())
  estatePlanId       String
  runId              String?
  score              Int?
  estateComplexity   String?
  estimatedEstateTax String?
  missingDocuments   String
  outdatedDocuments  String
  inconsistencies    String
  taxOptimization    String?
  medicaidPlanning   String?
  recommendations    String
  stateSpecificNotes String
  rawAnalysis        String?
  createdAt          DateTime   @default(now())
  analysisType       String     @default("quick")
  documentInventory  String?
  priorityMatrix     String?
  scenarioAnalysis   String?
  scoreBreakdown     String?
  stateResearch      String?
  estatePlan         EstatePlan @relation(fields: [estatePlanId], references: [id], onDelete: Cascade)
  run                AgentRun?  @relation(fields: [runId], references: [id])

  @@index([estatePlanId])
  @@index([estatePlanId, createdAt])
}

model UploadedDocument {
  id                  String                @id @default(cuid())
  estatePlanId        String
  storageId           String
  fileName            String
  fileSize            Int
  mimeType            String
  documentType        UploadedDocumentType
  description         String?
  extractedText       String?
  analysisStatus      AnalysisStatus        @default(pending)
  analysisResult      String?
  analysisError       String?
  uploadedAt          DateTime              @default(now())
  extractedAt         DateTime?
  analyzedAt          DateTime?
  estatePlan          EstatePlan            @relation(fields: [estatePlanId], references: [id], onDelete: Cascade)
  extractedIntakeData ExtractedIntakeData[] @relation("ExtractedIntakeDataToUploadedDocument")

  @@index([estatePlanId])
  @@index([estatePlanId, documentType])
  @@index([estatePlanId, analysisStatus])
}

model ExtractedIntakeData {
  id                String              @id @default(cuid())
  estatePlanId      String
  section           IntakeSection
  extractedData     String
  sourceDocumentIds String[]
  confidence        Int
  status            ExtractedDataStatus @default(extracted)
  createdAt         DateTime            @default(now())
  estatePlan        EstatePlan          @relation(fields: [estatePlanId], references: [id], onDelete: Cascade)
  sourceDocuments   UploadedDocument[]  @relation("ExtractedIntakeDataToUploadedDocument")

  @@index([estatePlanId])
  @@index([estatePlanId, section])
}

model Reminder {
  id                String             @id @default(cuid())
  estatePlanId      String
  userId            String?
  type              ReminderType
  title             String
  description       String?
  lifeEvent         LifeEventType?
  dueDate           DateTime
  status            ReminderStatus     @default(pending)
  snoozedUntil      DateTime?
  priority          Priority           @default(medium)
  isRecurring       Boolean            @default(false)
  recurrencePattern RecurrencePattern?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  completedAt       DateTime?
  sourceType        String?
  sourceId          String?
  isAutoGenerated   Boolean            @default(false)
  parentReminderId  String?
  estatePlan        EstatePlan         @relation(fields: [estatePlanId], references: [id], onDelete: Cascade)
  parentReminder    Reminder?          @relation("ReminderSubtasks", fields: [parentReminderId], references: [id])
  subTasks          Reminder[]         @relation("ReminderSubtasks")
  user              User?              @relation(fields: [userId], references: [id])

  @@index([estatePlanId])
  @@index([userId])
  @@index([estatePlanId, status])
  @@index([estatePlanId, dueDate])
  @@index([sourceId])
  @@index([parentReminderId])
}

model LifeEvent {
  id                     String        @id @default(cuid())
  estatePlanId           String
  eventType              LifeEventType
  title                  String
  description            String?
  eventDate              DateTime
  requiresDocumentUpdate Boolean       @default(false)
  documentsAffected      String?
  planUpdated            Boolean       @default(false)
  planUpdatedAt          DateTime?
  createdAt              DateTime      @default(now())
  estatePlan             EstatePlan    @relation(fields: [estatePlanId], references: [id], onDelete: Cascade)

  @@index([estatePlanId])
  @@index([estatePlanId, eventType])
}

model BeneficiaryDesignation {
  id                                String               @id @default(cuid())
  estatePlanId                      String
  assetType                         BeneficiaryAssetType
  assetName                         String
  institution                       String?
  accountNumber                     String?
  estimatedValue                    String?
  primaryBeneficiaryName            String
  primaryBeneficiaryRelationship    String?
  primaryBeneficiaryPercentage      Int?
  contingentBeneficiaryName         String?
  contingentBeneficiaryRelationship String?
  contingentBeneficiaryPercentage   Int?
  lastReviewedDate                  String?
  notes                             String?
  createdAt                         DateTime             @default(now())
  updatedAt                         DateTime             @updatedAt
  estatePlan                        EstatePlan           @relation(fields: [estatePlanId], references: [id], onDelete: Cascade)

  @@index([estatePlanId])
  @@index([estatePlanId, assetType])
}

model GuidedIntakeProgress {
  id             String     @id @default(cuid())
  estatePlanId   String     @unique
  currentStep    Int        @default(1)
  completedSteps Int[]      @default([])
  stepData       Json       @default("{}")
  flowMode       String     @default("guided")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  estatePlan     EstatePlan @relation(fields: [estatePlanId], references: [id], onDelete: Cascade)
}

model FamilyContact {
  id           String      @id @default(cuid())
  estatePlanId String
  name         String
  relationship String?
  role         ContactRole
  phone        String?
  email        String?
  address      String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  estatePlan   EstatePlan  @relation(fields: [estatePlanId], references: [id], onDelete: Cascade)

  @@index([estatePlanId])
  @@index([estatePlanId, role])
}

model AttorneyQuestion {
  id           String           @id @default(cuid())
  estatePlanId String
  question     String
  category     QuestionCategory
  isAnswered   Boolean          @default(false)
  answer       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  estatePlan   EstatePlan       @relation(fields: [estatePlanId], references: [id], onDelete: Cascade)

  @@index([estatePlanId])
  @@index([estatePlanId, category])
}

model DocumentChecklistItem {
  id           String            @id @default(cuid())
  estatePlanId String
  title        String
  description  String?
  category     ChecklistCategory
  status       ChecklistStatus   @default(not_gathered)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  estatePlan   EstatePlan        @relation(fields: [estatePlanId], references: [id], onDelete: Cascade)

  @@index([estatePlanId])
  @@index([estatePlanId, category])
}

model GapAnalysisRun {
  id              String             @id @default(cuid())
  estatePlanId    String
  status          GapRunStatus       @default(pending)
  analysisType    String             @default("comprehensive")
  currentPhase    Int                @default(1)
  totalPhases     Int                @default(3)
  progressPercent Int                @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  error           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  phases          GapAnalysisPhase[]
  estatePlan      EstatePlan         @relation(fields: [estatePlanId], references: [id], onDelete: Cascade)

  @@index([estatePlanId])
  @@index([estatePlanId, status])
}

model GapAnalysisPhase {
  id            String                 @id @default(cuid())
  runId         String
  phaseNumber   Int
  name          String
  status        GapRunStatus           @default(pending)
  totalRuns     Int                    @default(0)
  completedRuns Int                    @default(0)
  failedRuns    Int                    @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  run           GapAnalysisRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  runResults    GapAnalysisRunResult[]

  @@index([runId])
}

model GapAnalysisRunResult {
  id          String           @id @default(cuid())
  phaseId     String
  runType     String
  status      GapRunStatus     @default(pending)
  result      Json?
  rawOutput   String?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  phase       GapAnalysisPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
}

enum RunStatus {
  pending
  running
  completed
  failed
}

enum EstatePlanStatus {
  draft
  intake_in_progress
  intake_complete
  analysis_complete
  documents_generated
  complete
}

enum IntakeSection {
  personal
  family
  assets
  existing_documents
  goals
}

enum DocumentType {
  will
  trust
  poa_financial
  poa_healthcare
  healthcare_directive
  hipaa
  other
}

enum DocumentFormat {
  markdown
  html
  pdf
}

enum DocumentStatus {
  draft
  reviewed
  final
}

enum UploadedDocumentType {
  will
  trust
  poa_financial
  poa_healthcare
  healthcare_directive
  deed
  insurance_policy
  beneficiary_form
  other
}

enum AnalysisStatus {
  pending
  extracting
  analyzing
  completed
  failed
}

enum ExtractedDataStatus {
  extracted
  reviewed
  applied
  rejected
}

enum ReminderType {
  annual_review
  life_event
  document_update
  beneficiary_review
  custom
}

enum ReminderStatus {
  pending
  completed
  snoozed
  dismissed
}

enum Priority {
  low
  medium
  high
  urgent
}

enum RecurrencePattern {
  monthly
  quarterly
  annually
  biannually
}

enum LifeEventType {
  marriage
  divorce
  birth
  death
  major_asset_change
  relocation
  retirement
  business_change
  health_change
  other
}

enum BeneficiaryAssetType {
  retirement_401k
  retirement_ira
  retirement_roth
  retirement_pension
  retirement_other
  life_insurance
  annuity
  bank_pod
  brokerage_tod
  real_estate_tod
  other
}

enum ContactRole {
  executor
  trustee
  healthcare_proxy
  financial_poa
  guardian
  beneficiary
  advisor
  attorney
  other
}

enum QuestionCategory {
  documents
  assets
  beneficiaries
  tax
  general
}

enum ChecklistCategory {
  real_estate
  financial
  retirement
  insurance
  business
  personal
  existing_documents
}

enum ChecklistStatus {
  not_gathered
  in_progress
  gathered
}

enum GapRunStatus {
  pending
  running
  completed
  failed
}
